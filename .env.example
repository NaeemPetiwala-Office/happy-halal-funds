# Copy to .env and fill in YOUR Supabase project's values. .env is git-ignored.
# Find them in the Supabase dashboard: Project Settings -> API.
# These two are public by design (safe in the browser). NEVER put a secret / service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Only used by scripts/rls-check.ts (local testing). Two test users you create yourself in
# Authentication -> Users. Never commit these.
RLS_A_EMAIL=
RLS_A_PASSWORD=
RLS_B_EMAIL=
RLS_B_PASSWORD=
